{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/atlas/mcp.html",
        "http://localhost/atlas/mcp/servers/stripe.html",
        "http://localhost/atlas/mcp/features/mcp.as.cimd.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }]
      }
    }
  }
}
