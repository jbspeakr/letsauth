---
import GradeBadge from "@/components/GradeBadge.astro";
import Base from "@/layouts/Base.astro";
import { currentRevision } from "@/lib/atlas";
import { getDataset } from "@/lib/data";
import { passiveChecks, scannerFacts, scannerIndex, unscannedFeatures } from "@/lib/scanner";
import { GRADE_RULE } from "@/scanner/grade";
import { SCANNER_ID, USER_AGENT } from "@/scanner/version";

const data = getDataset();
const revision = currentRevision(data);
const views = scannerIndex(data);
const checks = passiveChecks(data);
const unscanned = unscannedFeatures(data);
const facts = scannerFacts(views);
const repo = "https://github.com/jbspeakr/letsauth";
const issue = `${repo}/issues/new?template=observation.yml`;
---

<Base
  title="Scanner"
  description={`The passive scanner behind the MCP auth atlas: what it reads, how it grades, and the latest report for each of the ${facts.servers} listed servers against MCP Authorization ${revision.id}.`}
  path="/scanner/"
>
  <div class="wrap">
    <header class="page-head scanner-head">
      <div class="scanner-head__copy">
        <p class="eyebrow">Scanner</p>
        <h1>What a server's metadata says, measured every night</h1>
        <p class="lede">
          The scanner reads the public authorization metadata an MCP server publishes for every
          client and judges the {checks.length} requirements of MCP Authorization {revision.id} that
          metadata can answer. Nothing else is sent: no token, no authorization flow, no request to
          the endpoint itself. Results land in the atlas as observations, by pull request.
        </p>
      </div>
      <dl class="facts" aria-label="Scanner at a glance">
        <div>
          <dt>Servers listed</dt>
          <dd class="num">{facts.servers}</dd>
        </div>
        <div>
          <dt>Scanned</dt>
          <dd class="num">{facts.scanned}</dd>
        </div>
        <div>
          <dt>Checks per server</dt>
          <dd class="num">{checks.length}</dd>
        </div>
        <div>
          <dt>Newest scan</dt>
          <dd class:list={["num", { muted: !facts.newest }]}>
            {facts.newest ? <time datetime={facts.newest}>{facts.newest.slice(0, 10)}</time> : "none yet"}
          </dd>
        </div>
      </dl>
    </header>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title">How it works</h2>
      <div class="how__grid">
        <article class="card">
          <h3>What it reads</h3>
          <ol>
            <li>
              The protected resource metadata (RFC 9728) at the path-aware well-known location
              derived from the server URL, then at the root.
            </li>
            <li>
              For the first authorization server the metadata names: its metadata at the three
              well-known locations the MCP specification lists (RFC 8414 and OpenID Connect
              Discovery, path-inserted and path-appended).
            </li>
          </ol>
          <p>
            At most five <code>GET</code> requests over HTTPS, no credentials, redirects followed
            only on the same host. It identifies itself as <code>{USER_AGENT}</code>.
          </p>
        </article>
        <article class="card">
          <h3>What a status means</h3>
          <p>
            <strong>Supported</strong> and <strong>unsupported</strong> are written only when a
            document was fetched and the deciding field is present or absent.
            <strong>Unknown</strong> means the scanner could not tell: the document could not be
            fetched, no authorization server was named, or nothing was advertised to judge. A
            fetch failure is never written as a failure of the server.
          </p>
          <p>
            Every observation starts with the URL that decided it and names the field and
            value, so a reviewer can open it.
          </p>
        </article>
        <article class="card" id="grade-rule">
          <h3>How the grade is derived</h3>
          <ol class="rule">
            {GRADE_RULE.map((line) => <li>{line}</li>)}
          </ol>
          <p>
            The grade is a property of one report at one time, derived from the statuses shown.
            The atlas never sorts or ranks servers by it.
          </p>
        </article>
      </div>
    </section>

    <section class="index" aria-labelledby="index-title">
      <h2 id="index-title">Latest report per listed server</h2>
      <p class="muted">
        Alphabetical. A server without a scanner observation reads "not scanned": the nightly run
        has not yet been able to read its metadata, or has not run since it was listed.
      </p>
      <div class="table-wrap">
        <table id="scanner-index">
          <thead>
            <tr>
              <th scope="col">Server</th>
              <th scope="col">Grade</th>
              <th scope="col">Newest scan</th>
              <th scope="col">Unknown</th>
              <th scope="col">Report</th>
            </tr>
          </thead>
          <tbody>
            {
              views.map((v) => (
                <tr data-server={v.server.id} data-grade={v.grade.letter ?? v.grade.label}>
                  <th scope="row">
                    <a href={`/scanner/${v.server.id}/`}>{v.server.name}</a>
                    <span class="meta">
                      <code>{v.server.url}</code>
                    </span>
                  </th>
                  <td>
                    <GradeBadge grade={v.grade} />
                  </td>
                  <td>
                    {v.scannedAt ? (
                      <time datetime={v.scannedAt}>{v.scannedAt.slice(0, 10)}</time>
                    ) : (
                      <span class="muted">–</span>
                    )}
                  </td>
                  <td class="num">
                    {v.scanned ? v.checks.filter((c) => c.status === "unknown").length : <span class="muted">–</span>}
                  </td>
                  <td>
                    <a href={`/scanner/${v.server.id}/`}>Report</a> ·{" "}
                    <a href={`/scanner/${v.server.id}.json`}>JSON</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <div class="split">
      <section class="prose" aria-labelledby="self-title">
        <h2 id="self-title">Run it yourself</h2>
        <p>
          The same command runs the nightly job and your terminal:
        </p>
        <pre tabindex="0"><code>pnpm scan https://mcp.example.com/mcp   # any server, nothing written
pnpm scan notion                        # a listed server by id
pnpm scan notion --write                # append what the nightly rule would</code></pre>
        <p>
          <code>--write</code> appends observations to <code>data/observations/&lt;id&gt;.yaml</code>
          following the same append rule as the nightly run; open a pull request with the result.
          See <a href={`${repo}/blob/main/docs/scanner.md`} rel="noopener">docs/scanner.md</a>.
        </p>
      </section>
      <section class="prose" aria-labelledby="not-title">
        <h2 id="not-title">What it does not check</h2>
        <p>
          {unscanned.length} server-side requirements need a request to the endpoint or a reading of
          the implementation and stay out of a passive scan: for example
          {unscanned.slice(0, 3).map((f, i) => (
            <>
              {i > 0 && ", "}
              <a href={`/atlas/mcp/features/${f.id}/`}>{f.name}</a>
            </>
          ))}. Their cells come from documentation and manual checks until active probes exist for
          verified owners.
        </p>
        <h3 id="opt-out">Opting out</h3>
        <p>
          If you run a listed server and do not want it scanned,{" "}
          <a href={issue} rel="noopener">withdraw it</a> from the atlas; a withdrawn server is never
          contacted again. The scanner only reads documents a server publishes for every client.
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .scanner-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4) var(--space-7);
    align-items: end;
  }
  .scanner-head__copy .lede {
    margin-bottom: 0;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0 0 var(--space-2);
    padding-left: var(--space-6);
    border-left: 1px solid var(--line);
  }
  .facts dt {
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }
  .facts dd.muted {
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--ink-muted);
  }
  .how,
  .index {
    margin-bottom: var(--space-7);
  }
  .how h2,
  .index h2 {
    font-size: var(--text-xl);
  }
  .how__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-4);
  }
  .how__grid h3 {
    font-size: var(--text-md);
    margin-bottom: var(--space-3);
  }
  .how__grid p,
  .how__grid ol {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .how__grid ol {
    padding-left: 1.3em;
  }
  .how__grid li {
    margin-bottom: var(--space-2);
  }
  .how__grid strong {
    color: var(--ink);
  }
  .rule li::marker {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .muted {
    color: var(--ink-muted);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm), var(--inset-highlight);
  }
  #scanner-index {
    margin: 0;
  }
  #scanner-index thead th {
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-2);
  }
  #scanner-index th,
  #scanner-index td {
    padding-inline: var(--space-4);
    border-bottom-color: var(--line-soft);
  }
  #scanner-index tbody tr:last-child > * {
    border-bottom: 0;
  }
  #scanner-index tbody tr:hover > * {
    background: color-mix(in oklch, var(--accent-soft) 40%, transparent);
  }
  #scanner-index th[scope="row"] {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
  }
  #scanner-index th[scope="row"] > a {
    color: var(--ink);
    text-decoration: none;
  }
  #scanner-index th[scope="row"] > a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta {
    display: block;
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
  .meta code {
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-6) var(--space-8);
    margin-bottom: var(--space-7);
  }
  .split h2 {
    font-size: var(--text-xl);
    margin-top: 0;
  }
  pre {
    font-size: var(--text-xs);
  }
  @media (max-width: 56rem) {
    .scanner-head {
      grid-template-columns: 1fr;
    }
    .facts {
      padding-left: 0;
      border-left: 0;
      padding-top: var(--space-4);
      border-top: 1px solid var(--line);
    }
  }
</style>
