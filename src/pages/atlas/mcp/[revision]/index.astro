---
import MatrixPage from "@/components/MatrixPage.astro";
import Base from "@/layouts/Base.astro";
import { currentRevision, getSpec } from "@/lib/atlas";
import { getDataset } from "@/lib/data";

export function getStaticPaths() {
  return getSpec(getDataset()).revisions.map((r) => ({ params: { revision: r.id } }));
}

const { revision } = Astro.params;
const isCurrent = currentRevision(getDataset()).id === revision;
---

{
  isCurrent ? (
    <Base
      title="MCP auth atlas"
      description="The current revision of the MCP auth atlas lives at /atlas/mcp."
      path="/atlas/mcp"
      noindex
    >
      <meta slot="head" http-equiv="refresh" content="0; url=/atlas/mcp" />
      <div class="wrap prose">
        <p>
          Revision {revision} is the current one. The matrix is at <a href="/atlas/mcp">/atlas/mcp</a>.
        </p>
      </div>
    </Base>
  ) : (
    <Base
      title={`MCP auth atlas, revision ${revision}`}
      description={`Which public MCP servers support which features of the MCP Authorization specification as of revision ${revision}.`}
      path={`/atlas/mcp/${revision}`}
    >
      <MatrixPage revisionId={revision} />
    </Base>
  )
}
