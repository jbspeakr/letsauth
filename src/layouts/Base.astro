---
import "@/styles/global.css";
// The three fonts every page paints with, preloaded so text does not reflow when they swap in
// (the fontsource CSS declares them with font-display: swap; Vite gives both the same hashed URL).
import fontDisplay from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import fontBody from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import fontMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/atlas/mcp/". Defaults to the current path. */
  path?: string;
  /** When set, the page is excluded from search indexing and the sitemap hint. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://letsauth.eu");
const canonical = new URL(path ?? Astro.url.pathname, site);
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const fullTitle =
  title === "letsauth" ? "letsauth — the lab for agent auth" : `${title} · letsauth`;
const here = path ?? Astro.url.pathname;
const nav = [
  {
    href: "/atlas/mcp/",
    label: "MCP auth atlas",
    short: "MCP atlas",
    match: (p: string) => p.startsWith("/atlas/mcp/") && !p.startsWith("/atlas/mcp/contribute/"),
  },
  {
    href: "/atlas/standards/",
    label: "Agent auth atlas",
    short: "Standards",
    match: (p: string) => p.startsWith("/atlas/standards/"),
  },
  {
    href: "/atlas/mcp/contribute/",
    label: "Contribute",
    short: "Contribute",
    match: (p: string) => p.startsWith("/atlas/mcp/contribute/"),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="letsauth" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL("/og.png", site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      [fontBody, fontDisplay, fontMono].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Apply a stored theme before first paint. Stored value is a per-viewer convenience only.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {
      plausibleDomain && (
        <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="site-bg" aria-hidden="true"></div>
    <aside class="wip" aria-label="Project status">
      <div class="wrap wip__row">
        <span class="wip__dot" aria-hidden="true"></span>
        <p class="wip__text">
          <strong>Work in progress.</strong> letsauth is an early preview: the data is partial,
          pages change often, and nothing here is final yet.
        </p>
        <a class="wip__link" href="/atlas/mcp/contribute/">Help fill the gaps</a>
      </div>
    </aside>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="brand" href="/" aria-label="letsauth home">
          <svg class="brand__mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
            <defs>
              <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="var(--accent)" />
                <stop offset="1" stop-color="var(--accent-2)" />
              </linearGradient>
            </defs>
            <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#brand-g)" />
            <path
              d="M11 15.5v-3a5 5 0 0 1 10 0v3"
              fill="none"
              stroke="var(--bg-elevated)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
            <rect x="9" y="14.5" width="14" height="10" rx="3" fill="var(--bg-elevated)" />
            <circle cx="16" cy="19.5" r="1.6" fill="var(--accent-strong)" />
          </svg>
          <span class="brand__name">letsauth</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-label={item.label}
                aria-current={item.match(here) ? "page" : undefined}
              >
                <span class="nav-long">{item.label}</span>
                <span class="nav-short" aria-hidden="true">
                  {item.short}
                </span>
              </a>
            ))
          }
          <a href="https://github.com/jbspeakr/letsauth" rel="noopener" class="external">
            Source
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M3.5 2.5h6v6M9.5 2.5l-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </nav>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle colour theme"
          title="Toggle colour theme"
        >
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
          </svg>
          <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div class="site-footer__about">
          <p class="site-footer__brand">letsauth</p>
          <p>
            An independent lab for authentication in the agent era. The atlas contacts no server;
            every cell cites its source.
          </p>
        </div>
        <nav class="site-footer__links" aria-label="Footer">
          <a href="/atlas/mcp/">MCP auth atlas</a>
          <a href="/atlas/standards/">Agent auth atlas</a>
          <a href="/atlas/mcp/contribute/">Contribute</a>
          <a href="/atlas/mcp/data.json">MCP atlas data</a>
          <a href="/atlas/standards/data.json">Standards data</a>
          <a href="https://github.com/jbspeakr/letsauth" rel="noopener">GitHub</a>
        </nav>
        <ul class="site-footer__meta" aria-label="Licences and hosting">
          <li><span class="dot" aria-hidden="true"></span> Data CC BY 4.0</li>
          <li><span class="dot" aria-hidden="true"></span> Code MIT</li>
          <li><span class="dot" aria-hidden="true"></span> Hosted in the EU</li>
        </ul>
      </div>
    </footer>
    <script>
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const current = root.dataset.theme ?? (prefersDark ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    background: var(--accent);
    color: var(--accent-ink);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    z-index: 10;
  }
  .skip:focus {
    top: var(--space-2);
  }

  /* ambient background: a faint dot grid that fades out, and a soft accent glow near the top */
  .site-bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(70vh, 48rem);
    pointer-events: none;
    z-index: 0;
    background-image:
      radial-gradient(
        60rem 28rem at 12% -6rem,
        var(--accent-glow),
        transparent 70%
      ),
      radial-gradient(
        circle at 1px 1px,
        color-mix(in oklch, var(--ink) 9%, transparent) 1px,
        transparent 0
      );
    background-size:
      100% 100%,
      22px 22px;
    mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
  }
  body {
    position: relative;
  }
  .site-header,
  .site-main,
  .site-footer {
    position: relative;
    z-index: 1;
  }

  /* work-in-progress banner above the header */
  .wip {
    position: relative;
    z-index: 1;
    background: var(--accent-2-soft);
    border-bottom: 1px solid color-mix(in oklch, var(--accent-2) 30%, transparent);
    color: var(--ink);
    font-size: var(--text-xs);
  }
  .wip__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.25rem;
    padding-block: var(--space-1);
  }
  .wip__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent-2) 25%, transparent);
    animation: wip-pulse 2.4s var(--ease) infinite;
  }
  @keyframes wip-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent-2) 25%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px color-mix(in oklch, var(--accent-2) 8%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wip__dot {
      animation: none;
    }
  }
  .wip__text {
    margin: 0;
    max-width: none;
    line-height: 1.4;
  }
  .wip__text strong {
    color: var(--accent-2);
    font-weight: 600;
  }
  .wip__link {
    margin-left: auto;
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
    text-decoration-color: color-mix(in oklch, var(--accent-2) 60%, transparent);
  }
  .wip__link:hover {
    color: var(--accent-2);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg-glass);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid color-mix(in oklch, var(--line) 80%, transparent);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.2rem;
    line-height: 1;
  }
  .brand__mark {
    flex: none;
    filter: drop-shadow(0 1px 2px color-mix(in oklch, var(--accent) 30%, transparent));
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.45em 0.75em;
    border-radius: 999px;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }
  .site-nav a:hover {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 6%, transparent);
  }
  .site-nav a[aria-current="page"] {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 8%, transparent);
  }
  .site-nav .external svg {
    opacity: 0.6;
  }
  .nav-short {
    display: none;
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--ink-muted);
    cursor: pointer;
    box-shadow: var(--shadow-sm), var(--inset-highlight);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    transform: rotate(15deg);
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme="light"]) .theme-toggle .icon-moon {
      display: block;
    }
  }

  .site-main {
    flex: 1;
    padding-block: var(--space-7) var(--space-9);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    padding-block: var(--space-7) var(--space-7);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .site-footer__brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    font-size: 1.1rem;
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
  }
  .site-footer__about p:last-child {
    margin: 0;
    max-width: 40ch;
  }
  .site-footer__links {
    display: grid;
    gap: var(--space-2);
  }
  .site-footer__links a {
    color: var(--ink-muted);
    text-decoration: none;
    width: fit-content;
  }
  .site-footer__links a:hover {
    color: var(--ink);
  }
  .site-footer__meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .site-footer__meta li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-footer__meta .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  @media (max-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
  @media (max-width: 40rem) {
    .site-header__row {
      gap: var(--space-3);
    }
    .site-nav {
      gap: 0;
      font-size: var(--text-xs);
    }
    .site-nav a {
      padding: 0.45em 0.55em;
    }
    .site-nav .external,
    .nav-long {
      display: none;
    }
    .nav-short {
      display: inline;
    }
    .site-main {
      padding-block: var(--space-6) var(--space-8);
    }
    .wip__link {
      display: none;
    }
  }
</style>
