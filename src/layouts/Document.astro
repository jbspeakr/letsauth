---
import Base from "@/layouts/Base.astro";

/**
 * A long-form text page (about, imprint, privacy, contribute and the like): breadcrumb, the
 * shared page head, a prose body and a dated foot line. Pages put their sections in the
 * default slot.
 */
interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  /** The h1. Defaults to the title. */
  heading?: string;
  lede?: string;
  /** The trail before the page's own title. Defaults to Home. */
  crumbs?: { href: string; label: string }[];
  /** ISO date (YYYY-MM-DD) the text was last changed; omit on pages that are not dated. */
  updated?: string;
}

const {
  title,
  description,
  path,
  eyebrow,
  heading,
  lede,
  crumbs = [{ href: "/", label: "Home" }],
  updated,
} = Astro.props;
const updatedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : undefined;
---

<Base title={title} description={description} path={path}>
  <article class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      {
        crumbs.map((c) => (
          <>
            <a href={c.href}>{c.label}</a> <span aria-hidden="true">/</span>{" "}
          </>
        ))
      }
      {title}
    </nav>
    <header class="page-head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading ?? title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <div class="prose doc__body">
      <slot />
    </div>
    {
      updated && (
        <footer class="page-foot prose">
          <p class="doc__updated">
            Last updated <time datetime={updated}>{updatedLabel}</time>
          </p>
        </footer>
      )
    }
  </article>
</Base>

<style>
  .doc__updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
</style>

<style is:global>
  /* Body typography for document pages. Wrapped in :where() so a page's own classes win. */
  :where(.doc__body) h2 {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  :where(.doc__body) h2:first-child {
    margin-top: 0;
  }
  :where(.doc__body) :where(ul, ol) {
    padding-left: 1.3em;
  }
  :where(.doc__body) :where(ul, ol) > li {
    margin-bottom: var(--space-2);
    padding-left: 0.2em;
  }
  :where(.doc__body) li::marker {
    color: var(--accent);
  }
  :where(.doc__body) address {
    font-style: normal;
    max-width: 24rem;
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }
</style>
