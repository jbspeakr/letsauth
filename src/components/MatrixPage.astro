---
import {
  currentRevision,
  getSpec,
  matrixFor,
  revisionDiff,
  revisionsNewestFirst,
} from "@/lib/atlas";
import { getDataset } from "@/lib/data";
import { CATEGORY_LABEL, PARTY_LABEL, STATUS_ORDER } from "@/lib/labels";
import Matrix from "./Matrix.svelte";
import MatrixTable from "./MatrixTable.astro";
import StatusCell from "./StatusCell.astro";

interface Props {
  revisionId: string;
}

const { revisionId } = Astro.props;
const data = getDataset();
const spec = getSpec(data);
const matrix = matrixFor(data, revisionId);
const current = currentRevision(data);
const isCurrent = revisionId === current.id;
const revisions = revisionsNewestFirst(data);
const previous = matrix.revision.supersedes;
const diff = previous ? revisionDiff(data, previous, revisionId) : undefined;
const levels = ["MUST", "SHOULD", "MAY", "DEPRECATED", "REMOVED"] as const;
const usedLevels = new Set(
  matrix.columns.map((f) => f.revisions.find((r) => r.revision === revisionId)?.level),
);
const usedCategories = [...new Set(matrix.columns.map((f) => f.category))];
const hrefFor = (id: string) => (id === current.id ? "/atlas/mcp" : `/atlas/mcp/${id}`);
---

<div class="wrap">
  <header class="page-head">
    <p class="eyebrow">MCP auth atlas</p>
    <h1>Who supports what in <span class="nowrap">MCP Authorization</span></h1>
    <p class="lede">
      Every public MCP server we list, against every requirement the specification puts on servers
      and their authorization servers. Each cell cites an observation; nothing here is inferred
      from silence.
    </p>
    <div class="revision-bar" aria-label="Specification revision">
      <div>
        <span class="revision-label">Revision</span>
        <strong class="revision-id" data-revision>{matrix.revision.id}</strong>
        <span class="pill">{isCurrent ? "current" : matrix.revision.status}</span>
        <span class="revision-date">
          published <time datetime={matrix.revision.date}>{matrix.revision.date}</time>
          {" · "}
          <a href={matrix.revision.url} rel="noopener">{spec.name} {matrix.revision.id}</a>
        </span>
      </div>
      <nav class="revision-switch" aria-label="Other revisions">
        {
          revisions.map((r) =>
            r.id === revisionId ? (
              <span class="button current" aria-current="page">
                {r.id}
              </span>
            ) : (
              <a class="button" href={hrefFor(r.id)}>
                {r.id}
              </a>
            ),
          )
        }
        {
          diff && (
            <a class="button" href={`/atlas/mcp/changes/${diff.from.id}/${diff.to.id}`}>
              What changed since {diff.from.id}
            </a>
          )
        }
      </nav>
    </div>
  </header>

  <section class="legend" aria-label="Legend">
    <ul class="legend__statuses">
      {
        STATUS_ORDER.map((s) => (
          <li>
            <StatusCell status={s} variant="label" />
          </li>
        ))
      }
    </ul>
    <p class="legend__note">
      <span class="level level-MUST">MUST</span>, <span class="level level-SHOULD">SHOULD</span>
      {" and "}
      <span class="level level-MAY">MAY</span> are the requirement levels the revision puts on the
      feature. <abbr title="MCP server (resource server)">RS</abbr>
      {" and "}
      <abbr title="Authorization server">AS</abbr> name the party the feature is observed on. Rows
      are alphabetical and nothing here ranks servers.
    </p>
  </section>

  <form id="matrix-filters" class="filters" method="get" action={hrefFor(revisionId)}>
    <div class="field">
      <label for="f-q">Search servers</label>
      <input id="f-q" name="q" type="search" placeholder="e.g. stripe" autocomplete="off" />
    </div>
    <div class="field">
      <label for="f-level">Level</label>
      <select id="f-level" name="level">
        <option value="">All levels</option>
        {levels.filter((l) => usedLevels.has(l)).map((l) => <option value={l}>{l}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-category">Category</label>
      <select id="f-category" name="category">
        <option value="">All categories</option>
        {usedCategories.map((c) => <option value={c}>{CATEGORY_LABEL[c]}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-party">Party</label>
      <select id="f-party" name="party">
        <option value="">Both parties</option>
        <option value="mcp-server">{PARTY_LABEL["mcp-server"]}</option>
        <option value="authorization-server">{PARTY_LABEL["authorization-server"]}</option>
      </select>
    </div>
    <div class="field actions">
      <button type="submit" class="button">Apply</button>
      <button type="reset" class="button">Reset</button>
    </div>
    <p id="matrix-count" class="count" aria-live="polite">
      {matrix.rows.length} of {matrix.rows.length} servers, {matrix.columns.length} of{" "}
      {matrix.columns.length} features
    </p>
  </form>

  <MatrixTable matrix={matrix} diff={diff} />
  <Matrix client:idle />

  <footer class="page-foot prose">
    <p>
      Servers come from public directories and maintainers; the listing reason and source are on
      each server page. A cell shows the newest observation for that server and feature; older
      observations stay in the history. <strong>Unknown</strong> means nobody has recorded an
      observation yet. The atlas does not contact any server.
    </p>
    <p>
      <a href="/atlas/mcp/data.json">Download this matrix as JSON</a> ·
      <a href="/atlas/mcp/contribute">Add or correct an observation</a>
    </p>
  </footer>
</div>

<style>
  .page-head {
    margin-bottom: var(--space-5);
  }
  .nowrap {
    white-space: nowrap;
  }
  .revision-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    font-size: var(--text-sm);
  }
  .revision-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-right: var(--space-2);
  }
  .revision-id {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    margin-right: var(--space-2);
  }
  .revision-date {
    color: var(--ink-muted);
    margin-left: var(--space-2);
  }
  .revision-switch {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .button.current {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }
  .legend__statuses {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    padding: 0;
    margin: 0;
  }
  .legend__note {
    margin: 0;
    color: var(--ink-muted);
    max-width: 60ch;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .field label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .field input,
  .field select {
    font: inherit;
    font-size: var(--text-sm);
    padding: 0.45em 0.7em;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--ink);
    min-width: 9rem;
  }
  .actions {
    flex-direction: row;
    gap: var(--space-2);
  }
  .count {
    margin: 0 0 0 auto;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    font-family: var(--font-display);
  }
  .page-foot {
    margin-top: var(--space-5);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 40rem) {
    .count {
      margin-left: 0;
    }
  }
</style>
