---
import Citation from "@/components/Citation.astro";
import Explorer from "@/components/Explorer.svelte";
import SequenceDiagram from "@/components/SequenceDiagram.astro";
import TokenView from "@/components/TokenView.astro";
import Base from "@/layouts/Base.astro";
import { getDataset } from "@/lib/data";
import { featureSupport, resolveChain } from "@/lib/explorer";
import { ACTOR_KIND_LABEL, PARTY_LABEL, TOGGLE_KIND_LABEL } from "@/lib/labels";
import type { Scenario } from "@/schema";

interface Props {
  scenario: Scenario;
  toggleId?: string;
}

const { scenario, toggleId } = Astro.props;
const data = getDataset();
const chain = resolveChain(scenario, toggleId);
const toggle = chain.toggle;
const path = toggle ? `/explorer/${scenario.id}/${toggle.id}/` : `/explorer/${scenario.id}/`;
const actorById = new Map(scenario.actors.map((a) => [a.id, a]));
const featureById = new Map(data.features.map((f) => [f.id, f]));
const exercised = scenario.features.flatMap((id) => {
  const f = featureById.get(id);
  return f ? [f] : [];
});
const violated = (toggle?.violates ?? []).map((id) => featureSupport(data, id));
const repo = "https://github.com/jbspeakr/letsauth";
const title = toggle ? `${scenario.title} · ${toggle.name}` : scenario.title;
const description = toggle
  ? `${scenario.title}, with ${toggle.name.toLowerCase()} (${TOGGLE_KIND_LABEL[toggle.kind].toLowerCase()}) turned on: ${toggle.summary.trim()}`
  : scenario.summary.trim();
const removedCount = chain.steps.filter((s) => s.removed).length;
const toggledCount = chain.steps.filter((s) => s.toggled && !s.removed).length;
---

<Base title={title} description={description} path={path}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/explorer/">Explorer</a> <span aria-hidden="true">/</span>
      {toggle ? <><a href={`/explorer/${scenario.id}/`}>{scenario.title}</a> <span aria-hidden="true">/</span> {toggle.name}</> : scenario.title}
    </nav>
    <header class="head">
      <p class="eyebrow">Delegation chain explorer</p>
      <h1>{scenario.title}</h1>
      <p class="lede">{scenario.summary}</p>
      <p class="actors" aria-label="Actors">
        {
          scenario.actors.map((a) => (
            <span class="pill" data-actor={a.id}>
              <span class="actors__kind">{ACTOR_KIND_LABEL[a.kind]}</span> {a.name}
            </span>
          ))
        }
      </p>
    </header>

    <nav class="toggles card" aria-label="Toggles">
      <p class="toggles__label">
        {scenario.toggles.length === 0 ? "This scenario has no toggles yet." : "Turn one attack or misconfiguration on:"}
      </p>
      <ul role="list" class="toggles__list">
        <li>
          <a class:list={["toggle", { current: !toggle }]} href={`/explorer/${scenario.id}/`} aria-current={!toggle ? "page" : undefined}>
            Baseline
          </a>
        </li>
        {
          scenario.toggles.map((t) => (
            <li>
              <a
                class:list={["toggle", `kind-${t.kind}`, { current: toggle?.id === t.id }]}
                href={`/explorer/${scenario.id}/${t.id}/`}
                aria-current={toggle?.id === t.id ? "page" : undefined}
                data-toggle={t.id}
              >
                {t.name}
                <span class="toggle__kind">{TOGGLE_KIND_LABEL[t.kind]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      toggle && (
        <section class:list={["notice", "card", `kind-${toggle.kind}`]} data-toggle-notice aria-labelledby="toggle-title">
          <p class="eyebrow">{TOGGLE_KIND_LABEL[toggle.kind]} on</p>
          <h2 id="toggle-title">{toggle.name}</h2>
          <p>{toggle.summary}</p>
          <p class="notice__meta">
            {toggledCount > 0 && <span>{toggledCount} step{toggledCount === 1 ? "" : "s"} changed</span>}
            {removedCount > 0 && <span>{removedCount} step{removedCount === 1 ? "" : "s"} removed</span>}
            <span>
              Forbidden or warned against in <Citation entry={toggle.cites} withRevision />
            </span>
          </p>
          {violated.length > 0 && (
            <div class="violates">
              <h3>Requirements this defeats</h3>
              <ul role="list">
                {violated.map((v) => (
                  <li data-violates={v.feature.id}>
                    <a href={`/atlas/mcp/features/${v.feature.id}/`}>{v.feature.name}</a>
                    <span class="pill">{PARTY_LABEL[v.feature.party]}</span>
                    {v.observed ? (
                      <span class="violates__counts">
                        Listed servers under MCP Authorization {v.revisionId}: {v.counts.supported} supported, {v.counts.partial} partial, {v.counts.unsupported} unsupported, {v.counts.unknown} unknown
                        {v.counts.notApplicable > 0 && `, ${v.counts.notApplicable} not applicable`}.
                      </span>
                    ) : (
                      <span class="violates__counts">{v.reason}.</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }

    <Explorer client:idle />
    <SequenceDiagram chain={chain} />

    <section class="steps-section" aria-labelledby="steps-title">
      <h2 id="steps-title">The chain, step by step</h2>
      <ol id="chain-steps" class="steps" role="list">
        {
          chain.steps.map((s) => {
            const from = actorById.get(s.from);
            const to = actorById.get(s.to);
            return (
              <li
                id={`step-${s.id}`}
                class:list={["step", "card", { "is-toggled": s.toggled && !s.removed, "is-removed": s.removed }]}
                data-step={s.id}
                data-index={s.index}
                data-toggled={s.toggled && !s.removed ? "" : undefined}
                data-removed={s.removed ? "" : undefined}
                data-replaces={s.replaces}
              >
                <p class="step__who">
                  <span class="step__num" aria-hidden="true">{s.index}</span>
                  <span class="visually-hidden">Step {s.index}:</span>
                  <strong>{from?.name}</strong>
                  <span class="step__arrow" aria-hidden="true">→</span>
                  <span class="visually-hidden">to</span>
                  <strong>{s.from === s.to ? "itself" : to?.name}</strong>
                  {s.toggled && !s.removed && (
                    <span class="pill accent">{s.replaces ? `replaces step "${s.replaces}"` : "changed by the toggle"}</span>
                  )}
                  {s.removed && <span class="pill removed">removed by the toggle</span>}
                </p>
                <p class="step__message">{s.removed ? <s>{s.message}</s> : s.message}</p>
                {s.note && <p class="step__note">{s.note}</p>}
                <p class="step__cite">
                  Cites <Citation entry={s.cites} withRevision />
                </p>
                {s.token && !s.removed && <TokenView token={s.token} />}
              </li>
            );
          })
        }
      </ol>
    </section>

    <section id="requirements" class="requirements" aria-labelledby="requirements-title">
      <h2 id="requirements-title">Requirements this chain exercises</h2>
      <p class="muted">
        Each is a feature of the MCP auth atlas; the atlas page shows which listed servers meet it.
      </p>
      <ul role="list" class="requirements__list">
        {
          exercised.map((f) => (
            <li data-feature={f.id}>
              <a href={`/atlas/mcp/features/${f.id}/`}>{f.name}</a>
              <span class="pill">{PARTY_LABEL[f.party]}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="data-links">
      <a class="button small" href="/explorer/data.json">All scenarios (JSON)</a>
      <a class="button small" href={`${repo}/blob/main/data/scenarios/${scenario.id}.yaml`} rel="noopener">Data file</a>
      <a class="button small" href={`${repo}/edit/main/data/scenarios/${scenario.id}.yaml`} rel="noopener">Propose a change</a>
    </p>
  </div>
</Base>

<style>
  .head {
    margin-bottom: var(--space-5);
  }
  .actors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    max-width: none;
  }
  .actors .pill {
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink);
  }
  .actors__kind {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .toggles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
  }
  .toggles__label {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .toggles__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }
  .toggle:hover {
    border-color: var(--line-strong);
  }
  .toggle.current {
    border-color: var(--ink);
    background: color-mix(in oklch, var(--ink) 8%, transparent);
  }
  .toggle.kind-attack.current {
    border-color: var(--status-unsupported);
    background: var(--status-unsupported-soft);
  }
  .toggle.kind-misconfiguration.current {
    border-color: var(--status-partial);
    background: var(--status-partial-soft);
  }
  .toggle__kind {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .notice {
    margin-bottom: var(--space-5);
    border-left: 4px solid var(--status-partial);
  }
  .notice.kind-attack {
    border-left-color: var(--status-unsupported);
  }
  .notice h2 {
    margin: var(--space-1) 0 var(--space-2);
  }
  .notice__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: none;
  }
  .violates h3 {
    font-size: var(--text-md);
    margin: var(--space-4) 0 var(--space-2);
  }
  .violates ul {
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .violates li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .violates__counts {
    color: var(--ink-muted);
    flex-basis: 100%;
  }
  .steps-section h2,
  .requirements h2 {
    margin-bottom: var(--space-3);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .step {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
    transition: border-color var(--dur-fast) var(--ease);
  }
  .step.is-toggled {
    border-color: color-mix(in oklch, var(--accent-2) 50%, transparent);
  }
  .step.is-removed {
    color: var(--ink-muted);
    border-style: dashed;
  }
  .step[aria-current="step"] {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .step__who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    max-width: none;
  }
  .step__num {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .is-toggled .step__num {
    background: var(--accent-2);
    color: var(--accent-ink);
  }
  .is-removed .step__num {
    background: var(--ink-faint);
  }
  .step__arrow {
    color: var(--ink-faint);
  }
  .pill.removed {
    border-color: color-mix(in oklch, var(--status-unsupported) 40%, transparent);
    color: var(--status-unsupported);
  }
  .step__message {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    overflow-wrap: anywhere;
    max-width: none;
  }
  .step__note {
    margin: 0 0 var(--space-2);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .step__cite {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .requirements {
    margin-top: var(--space-7);
  }
  .requirements__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .requirements__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  .data-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
    max-width: none;
  }
</style>
