---
import { MATURITY_LABEL, MATURITY_TAG } from "@/lib/labels";
import type { SpecMaturity } from "@/schema";

interface Props {
  maturity: SpecMaturity;
  /** The publisher's own label, shown as the title. */
  note?: string;
  /** "tag" is the short form used in lists; "label" spells the maturity out. */
  variant?: "tag" | "label";
}

const { maturity, note, variant = "tag" } = Astro.props;
const label = MATURITY_LABEL[maturity];
---

<span
  class:list={["maturity", `maturity-${maturity}`, variant]}
  data-maturity={maturity}
  title={note ? `${label}: ${note}` : label}
>
  <span class="swatch" aria-hidden="true"></span>
  {variant === "label" ? label : MATURITY_TAG[maturity]}
</span>

<style>
  /* Maturity is encoded by border style and a text tag, never by colour alone. */
  .maturity {
    --c: var(--ink-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c);
    white-space: nowrap;
  }
  .maturity.label {
    text-transform: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0;
  }
  .swatch {
    width: 0.85em;
    height: 0.85em;
    border-radius: 3px;
    border: 1.5px solid var(--c);
    background: transparent;
  }
  .maturity-published {
    --c: var(--accent);
  }
  .maturity-published .swatch {
    background: var(--c);
  }
  .maturity-in-force {
    --c: var(--accent-2);
  }
  .maturity-in-force .swatch {
    background: var(--c);
    border-radius: 50%;
  }
  .maturity-candidate {
    --c: var(--level-should);
  }
  .maturity-candidate .swatch {
    border-style: dotted;
    border-width: 2px;
  }
  .maturity-working-group-draft .swatch {
    border-style: dashed;
  }
  .maturity-individual-draft .swatch {
    border-style: dashed;
    border-width: 1px;
    opacity: 0.8;
  }
  .maturity-expired,
  .maturity-withdrawn {
    --c: var(--level-deprecated);
    text-decoration: line-through;
  }
  .maturity-expired .swatch,
  .maturity-withdrawn .swatch {
    opacity: 0.5;
  }
</style>
